{
  "/api/v2/robot/capabilities/MultiFloorMapCapability": {
    "get": {
      "tags": [
        "MultiFloorMapCapability"
      ],
      "summary": "Get the multi-floor map state and the stored maps",
      "responses": {
        "200": {
          "description": "Ok",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "maps": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/ValetudoFloorMap"
                    }
                  }
                }
              },
              "examples": {
                "twoFloors": {
                  "description": "Two stored maps, the first one is active",
                  "value": {
                    "enabled": true,
                    "maps": [
                      {"id": 120, "name": "Ground floor", "active": true, "segments": [{"id": "1", "name": "Kitchen"}], "metaData": {}},
                      {"id": 121, "active": false, "segments": [], "metaData": {}}
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "put": {
      "tags": [
        "MultiFloorMapCapability"
      ],
      "summary": "Enable multi-floor maps, or select, rename or delete a stored map",
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["action"],
              "properties": {
                "action": {
                  "type": "string",
                  "enum": ["set_enabled", "select", "rename", "delete"]
                },
                "enabled": {
                  "type": "boolean",
                  "description": "For set_enabled"
                },
                "id": {
                  "type": "integer",
                  "description": "Map id for select, rename and delete"
                },
                "name": {
                  "type": "string",
                  "description": "For rename. An empty name removes the custom name."
                }
              }
            },
            "examples": {
              "enable": {
                "value": {"action": "set_enabled", "enabled": true}
              },
              "select": {
                "description": "Move the robot and its dock to that floor first",
                "value": {"action": "select", "id": 121}
              },
              "rename": {
                "value": {"action": "rename", "id": 121, "name": "First floor"}
              },
              "delete": {
                "description": "Only for a map that is not active",
                "value": {"action": "delete", "id": 121}
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "$ref": "#/components/responses/200"
        },
        "400": {
          "$ref": "#/components/responses/400"
        }
      }
    }
  },
  "/api/v2/robot/capabilities/MultiFloorMapCapability/properties": {
    "get": {
      "tags": [
        "MultiFloorMapCapability"
      ],
      "summary": "Get various capability-related properties",
      "responses": {
        "200": {
          "description": "Ok",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "maxNameLength": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
